generator client {
  provider = "prisma-client-js"
}

// datasource db {
//   provider = "mysql"
//   url      = env("DATABASE_URL")
// }


datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}




model Users {
   UserId        String       @id @default(auto()) @map("_id") @db.ObjectId

  name          String?
  email         String?      @unique
  emailVerified DateTime?
  ProfileImage  String?
  password      String?
  role          Role         @default(ADMIN)
  Companies     Companies[]
  Items         Items[]
  Invoices      Invoices[]
  Quotations    Quotations[]
  Clients       Clients[]
  QuoteChats    QuoteChats[]
  InvoiceChats  InvoiceChats[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  CompanyId     String       @default("NONE")

  @@map("users")
}

model Companies {
  CompanyId     String      @id @default(auto()) @map("_id") @db.ObjectId
  UserId        String  @db.ObjectId
  user          Users?      @relation(fields: [UserId], references: [UserId])
  ContactPerson String
  ContactNo     String
  Logo          String?
  CompanyName   String
  Currency      String
  BankName      String
  BankType      String
  BankAccount   String
  PaymentTerms  String
  Type          CompanyType @default(Company)
  Email         String      @unique
  TagLine       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  Quotation     Quotations[]
  Invoice       Invoices[]
  Item          Items[]
  Client        Clients[]
}

model QuoteChats {
  QuoteChatId String  @id @default(auto()) @map("_id") @db.ObjectId
  UserId      String @db.ObjectId
  Users       Users   @relation(fields: [UserId], references: [UserId])
  QuotationId String @db.ObjectId
  Quotations  Quotations @relation(fields: [QuotationId], references: [QuotationId])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  Message     String
}

model InvoiceChats {
  InvoiceChatId String @id @default(auto()) @map("_id") @db.ObjectId
  UserId        String @db.ObjectId
  Users         Users   @relation(fields: [UserId], references: [UserId])
  InvoiceId     String @db.ObjectId
  Invoices      Invoices @relation(fields: [InvoiceId], references: [InvoiceId])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  Message       String
}

model Quotations {
  QuotationId       String         @id @default(auto()) @map("_id") @db.ObjectId
  status            DocStatus         @default(CREATED)
  UserId            String @db.ObjectId
  user              Users             @relation(fields: [UserId], references: [UserId])
  ClientId          String @db.ObjectId
  clients           Clients           @relation(fields: [ClientId], references: [ClientId])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  QuotationDetails  QuotationDetails[]
  QuoteChats        QuoteChats[]
  CompanyId         String @db.ObjectId
  Company           Companies         @relation(fields: [CompanyId], references: [CompanyId])
  Invoices          Invoices[]        // One-to-many relationship with Invoices
}

model QuotationDetails {
  QdId        String    @id @default(auto()) @map("_id") @db.ObjectId
  QuotationId String @db.ObjectId
  Quote       Quotations   @relation(fields: [QuotationId], references: [QuotationId])
  ItemId      String @db.ObjectId
  Items       Items        @relation(fields: [ItemId], references: [ItemId])
  Quantity    Int
  Amount      Float
}

model Invoices {
  InvoiceId      String           @id @default(auto()) @map("_id") @db.ObjectId
  status         DocStatus         @default(CREATED)
  UserId         String @db.ObjectId
  QuotationId    String @db.ObjectId
  Quotations     Quotations        @relation(fields: [QuotationId], references: [QuotationId])
  CompanyId      String @db.ObjectId
  Company        Companies         @relation(fields: [CompanyId], references: [CompanyId])
  user           Users?            @relation(fields: [UserId], references: [UserId])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  ClientId       String @db.ObjectId
  clients        Clients           @relation(fields: [ClientId], references: [ClientId])
  InvoiceDetails InvoiceDetails[]
  InvoiceChats   InvoiceChats[]
}

model InvoiceDetails {
  IdId      String    @id @default(auto()) @map("_id") @db.ObjectId
  InvoiceId String @db.ObjectId
  Invoice   Invoices   @relation(fields: [InvoiceId], references: [InvoiceId])
  ItemId    String @db.ObjectId
  Items     Items      @relation(fields: [ItemId], references: [ItemId])
  Quantity  Int
  Amount    Float
}

model Items {
  ItemId            String          @id @default(auto()) @map("_id") @db.ObjectId
  ItemName          String           @unique
  ItemType          String
  Description       String
  ItemStatus        ItemStatus
  Quantity          Int
  Amount            Float
  QuotationDetails  QuotationDetails[]
  InvoiceDetails    InvoiceDetails[]
  UserId            String @db.ObjectId
  CompanyId         String @db.ObjectId
  Company           Companies        @relation(fields: [CompanyId], references: [CompanyId])
  user              Users?           @relation(fields: [UserId], references: [UserId])
  Type              ItemTypeEnum     @default(SERVICE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model Clients {
  ClientId      String      @id @default(auto()) @map("_id") @db.ObjectId
  ClientName    String
  ClientType    CompanyType
  ContactPerson String
  ContactNumber String
  CompanyEmail  String       @unique
  UserId        String @db.ObjectId
  Quotations    Quotations[]
  Invoice       Invoices[]
  user          Users?       @relation(fields: [UserId], references: [UserId])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  CompanyId     String @db.ObjectId
  Company       Companies    @relation(fields: [CompanyId], references: [CompanyId])
}

enum ItemStatus {
  ACTIVE
  INACTIVE
}

enum DocStatus {
  CREATED
  CONVERTED
  PARTIAL
  CLOSED
  VOID
}

enum ItemTypeEnum {
  PRODUCT
  SERVICE
}

enum CompanyType {
  Individual
  Company
}

enum Role {
  ADMIN
  USER
  MANAGER
}
