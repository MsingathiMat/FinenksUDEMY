generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  UserId        String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  ProfileImage  String?
  password      String?      @db.VarChar(80)
  role          Role         @default(ADMIN)
  Companies     Companies[]
  Items         Items[]
  Invoices      Invoices[]
  Quotations    Quotations[]
  Clients       Clients[]
  QuoteChats QuoteChats[]
  InvoiceChats InvoiceChats[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
CompanyId String @default("NONE")


  @@map("users")
}

model Companies {
  CompanyId     String      @unique @default(uuid())
  UserId        String
  user          Users?      @relation(fields: [UserId], references: [UserId])
  ContactPerson String
  ContactNo     String
    Logo String? @db.VarChar(800)
  CompanyName   String
  Currency String
  BankName String
  BankType String
  BankAccount String
  PaymentTerms String
  Type          CompanyType @default(Company)
  Email         String      @unique
  TagLine       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  Quotation Quotations[]
  Invoice Invoices[]
  Item Items[]
  Client Clients[]
}





model QuoteChats {

  QuoteChatId Int @unique @default(autoincrement())
  UserId String
  Users Users @relation(fields: [UserId],references: [UserId])
  QuotationId String
  Quotations Quotations @relation(fields: [QuotationId],references: [QuotationId])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  Message String
}


model InvoiceChats {

  InvoiceChatId Int @unique @default(autoincrement())
  UserId String
  Users Users @relation(fields: [UserId],references: [UserId])
  InvoiceId String
  Invoices Invoices @relation(fields: [InvoiceId],references: [InvoiceId])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  Message String
}
model Quotations {
  status            DocStatus         @default(CREATED)
  QuotationId       String            @id @default(uuid())
  UserId            String
  user              Users             @relation(fields: [UserId], references: [UserId])
  ClientId          String
  clients           Clients           @relation(fields: [ClientId], references: [ClientId])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  QuotationDetails  QuotationDetails[]
  QuoteChats        QuoteChats[]
  CompanyId         String
  Company           Companies         @relation(fields: [CompanyId], references: [CompanyId])
  Invoices          Invoices[]        // One-to-many relationship with Invoices
}
model QuotationDetails {
  QdId Int @unique @default(autoincrement())
QuotationId String
  Quote Quotations @relation(fields: [QuotationId],references: [QuotationId])
ItemId String 

  
  Items Items @relation(fields: [ItemId], references: [ItemId])

Quantity Int
Amount Decimal

}



model Invoices {
  InvoiceId         String            @id @default(uuid())
  status            DocStatus         @default(CREATED)
  UserId            String
  QuotationId       String
  Quotations        Quotations        @relation(fields: [QuotationId], references: [QuotationId]) // Many-to-one relationship with Quotations
  CompanyId         String
  Company           Companies         @relation(fields: [CompanyId], references: [CompanyId])
  user              Users?            @relation(fields: [UserId], references: [UserId])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  ClientId          String
  clients           Clients           @relation(fields: [ClientId], references: [ClientId])
  InvoiceDetails    InvoiceDetails[]
   InvoiceChats        InvoiceChats[]
}

model InvoiceDetails {
  IdId Int @unique @default(autoincrement())
InvoiceId String
  Invoice Invoices @relation(fields: [InvoiceId],references: [InvoiceId])
ItemId String 
  Items Items @relation(fields: [ItemId], references: [ItemId])
Quantity Int
Amount Decimal

}

model Items {
  ItemId      String     @unique @default(uuid())
  ItemName    String     @unique
  ItemType    String
  Description String
  ItemStatus  ItemStatus
  Quantity    Int
  Amount      Decimal
QuotationDetails QuotationDetails[]
InvoiceDetails InvoiceDetails[]
  UserId String

 Company Companies @relation(fields: [CompanyId], references: [CompanyId])

  user      Users?       @relation(fields: [UserId], references: [UserId])
  Type      ItemTypeEnum @default(SERVICE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
      CompanyId String

  
}

model Clients {
  ClientId      String      @unique @default(uuid())
  ClientName    String     
  ClientType    CompanyType
  ContactPerson String
   ContactNumber String
  CompanyEmail  String  @unique

  UserId String
  Quotations Quotations[]
 Invoice Invoices[]
  user Users? @relation(fields: [UserId], references: [UserId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
      CompanyId String
  Company Companies @relation(fields: [CompanyId], references: [CompanyId])
}

enum ItemStatus {
  ACTIVE
  INACTIVE
}

enum DocStatus {
  CREATED
  CONVERTED
  PARTIAL
  CLOSED
  VOID
}

enum ItemTypeEnum {
  PRODUCT
  SERVICE
}

enum CompanyType {
  Individual
  Company
}

enum Role {
  ADMIN
  USER
  MANAGER
}
